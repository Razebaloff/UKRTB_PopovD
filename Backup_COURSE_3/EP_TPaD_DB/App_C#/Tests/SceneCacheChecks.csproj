<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SceneCacheChecks.cs" />
    <Compile Include="../App/*Drawing.cs" />
    <Compile Include="../App/AppScreen.cs" />
    <Compile Include="../App/ArtworkResources.cs" />
    <Compile Include="../App/RinkTypography.cs" />
    <Compile Include="../App/SceneSurfaceCache.cs" />
    <Compile Include="../App/ScheduleBoard.cs" />
    <Compile Include="../App/TrainingSchedule.cs" />
    <Compile Include="../App/TrainingBookingStore.cs" />
    <Compile Include="../App/TrainingBookingDialog.cs" />
    <EmbeddedResource Include="../App/Assets/*.png" Exclude="../App/Assets/IceFrame.png">
      <LogicalName>LP_PopovD_App.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
